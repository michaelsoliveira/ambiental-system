# Portas publicadas somente em 127.0.0.1. Altere se alguma estiver ocupada.
WEB_PORT=3000
API_PORT=3333
POSTGRES_PORT=5432
REDIS_PORT=6379
EVOLUTION_PORT=8080

# Banco local
POSTGRES_USER=ambiental
# Defina uma senha local forte antes de iniciar os containers.
POSTGRES_PASSWORD=
POSTGRES_DB=ambiental

# Aplicacao
REDIS_URL=redis://redis:6379/0
SERVER_PORT=3333
# Gere uma chave local longa antes de iniciar os containers.
JWT_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Necessarias pela validacao de ambiente; OAuth GitHub pode permanecer desabilitado localmente.
GITHUB_OAUTH_CLIENT_ID=local-placeholder
GITHUB_OAUTH_CLIENT_SECRET=local-placeholder
GITHUB_OAUTH_CLIENT_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Integracoes opcionais
AUTH_MODE=local
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_AUTH_LOCAL_FALLBACK=true
# Preencha somente se for ativar o perfil Evolution.
EVOLUTION_API_GLOBAL_KEY=
EVOLUTION_API_BASE_URL=http://evolution:8080
EVOLUTION_WEBHOOK_PUBLIC_URL=http://host.docker.internal:3333
# OPENAI_API_KEY=
# RESEND_API_KEY=
# OC_EMAIL_FROM=
