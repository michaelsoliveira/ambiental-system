# Copie para a raiz: cp docker/env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_esta_senha
POSTGRES_DB=ambiental

# --- API (@saas/env) ---
JWT_SECRET=gerar_string_longa_aleatoria
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# URL de callback registrada no GitHub OAuth App (geralmente o front ou a API, conforme o fluxo)
GITHUB_OAUTH_CLIENT_REDIRECT_URI=https://financeiro.bomanejo.com.br/api/auth/callback

# URL pública da API (HTTPS no domínio real)
# Os três GITHUB_* acima têm de existir também no processo do Next (financeiro): docker-compose.prod.yml repete-os no serviço financeiro.
NEXT_PUBLIC_API_URL=https://api-financeiro.bomanejo.com.br

# URL pública do Next (financeiro) — redirects OAuth/logout; evita https://0.0.0.0:3000 atrás do proxy
NEXT_PUBLIC_APP_URL=https://financeiro.bomanejo.com.br
# docker-compose.prod.yml define APP_URL=${NEXT_PUBLIC_APP_URL} no financeiro (runtime nos Route Handlers)

# --- Opcional: Asaas ---
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox
# ASAAS_WEBHOOK_TOKEN=

# SKIP_MIGRATE=0

# --- MinIO (CMS Landing — mídia do Hero) ---
# Produção na mesma VPS do licencas: fale com o container `minio` na rede app_network
# (docker-compose.prod.yml já conecta a API nessa rede).
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=landing-media
# URL pública (browser / landing). Path-style no nginx s3.bomanejo.com.br
MINIO_PUBLIC_URL=https://s3.bomanejo.com.br/landing-media
# Rede Docker do MinIO do licencas (produção: app_network)
# MINIO_DOCKER_NETWORK=app_network

# --- Redis (BullMQ — oc-worker / oc-beat) ---
REDIS_URL=redis://redis:6379/0

# --- Omnichannel / Evolution API (WhatsApp) ---
# Em produção o compose sobe o serviço `evolution` na rede Docker.
# A API e o oc-worker usam a URL interna (não publique 8080 no host).
EVOLUTION_API_BASE_URL=http://evolution:8080
EVOLUTION_API_GLOBAL_KEY=gerar_string_longa_aleatoria
# Evolution chama a API na mesma rede (inbound WhatsApp → /webhooks/evolution)
EVOLUTION_WEBHOOK_PUBLIC_URL=http://api:3333
# Opcional — validação HMAC do webhook
# EVOLUTION_WEBHOOK_SECRET=
# Imagem (opcional). Padrão: evoapicloud/evolution-api:v2.3.7
# EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7

# Respostas IA do omnichannel (oc-worker)
# OPENAI_API_KEY=
# OC_WORKER_CONCURRENCY=2
